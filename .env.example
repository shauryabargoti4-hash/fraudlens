# ==============================================================================
# ClauseGuard - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=ClauseGuard
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=clauseguard-development-secret-key-change-in-production
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8501", "http://127.0.0.1:8501"]

# Database Configuration (SQLite default for portability)
DATABASE_URL=sqlite:///./storage/clauseguard.db
DB_ECHO=false

# Storage Directories
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
CHROMA_DIR=./storage/chroma_db

# Document Intelligence & OCR Settings
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "txt", "png", "jpg", "jpeg", "tiff"]

# AI / LLM Configuration
# Options: "gemini", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30.0

# Vector & Embeddings Configuration
# Options: "mock", "gemini"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
CHROMA_COLLECTION_NAME=clauseguard_policies

# Fraud Analysis Thresholds
HIGH_RISK_THRESHOLD=70.0
MEDIUM_RISK_THRESHOLD=40.0
MAX_PERMISSIBLE_DATE_GAP_DAYS=180
