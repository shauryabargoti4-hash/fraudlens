# ==============================================================================
# ClauseGuard - FastAPI Backend Container
# ==============================================================================
FROM python:3.12-slim

# Prevent Python from buffering stdout/stderr and writing .pyc files
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies (curl for healthcheck, tesseract for OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tesseract-ocr \
    libtesseract-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy backend application code and sample data
COPY backend/ ./backend/
COPY sample_data/ ./sample_data/
COPY pytest.ini .

# Create persistent storage directories
RUN mkdir -p /app/storage/uploads /app/storage/chroma_db

# Expose FastAPI backend port
EXPOSE 8000

# Healthcheck probe against FastAPI /health endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Start Uvicorn ASGI server
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
